# Production: public website origin (no trailing slash).
APP_ORIGIN=https://penguin.example.com
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Set 1 only behind one trusted reverse proxy that terminates HTTPS.
TRUST_PROXY=0
# Persist this directory across deployments; keep it private.
DB_PATH=./.data/penguin.sqlite
# Optional absolute path to the existing game executable.
# GAME_EXE_PATH=C:/CJE/python_ex/pygame/AntarcticPenguin.exe
